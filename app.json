{
  "expo": {
    "name": "Buku Kas Ibuk",
    "slug": "buku-kas-ibuk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bukukas.ibuk"
    },
    "android": {
      "package": "com.bukukas.ibuk",
      "adaptiveIcon": {
        "backgroundColor": "#ECFDF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan aplikasi mengakses galeri foto untuk menyimpan bukti nota kwitansi.",
          "cameraPermission": "Izinkan aplikasi menggunakan kamera untuk memfoto bukti nota kwitansi."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "318661fe-4a58-4449-8aa7-84a5079e0c77"
      }
    },
    "owner": "alwii"
  }
}
